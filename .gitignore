__pycache__/
*.py[cod]
.venv/
venv/

# web (React dashboard, M9)
node_modules/
web/dist/
web/.vite/
web/coverage/
web/*.tsbuildinfo
.uv/
uv.lock.tmp
.mypy_cache/
dist/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# local data lake (raw/bronze/silver/gold) — never committed
data/lake/
artifacts/*
!artifacts/.gitkeep

# environment and cloud discovery output — may contain subscription/tenant IDs
.env
.env.*
infra/azure-discovery.json
infra/**/*.tfstate
infra/**/*.tfstate.backup
infra/**/.terraform/
infra/**/tfplan.local
infra/**/*.tfplan
# .terraform.lock.hcl is deliberately NOT ignored -- it pins provider
# versions and Terraform itself asks you to commit it.
*.tfvars

.DS_Store

# Power BI Desktop local workspace/cache state -- never committed.
# The .pbip/.Report/.SemanticModel source files themselves ARE committed;
# only Desktop's own local scratch/cache/lock state is excluded here.
powerbi/.pbi/
powerbi/**/.pbi/
powerbi/**/*.pbix.lock
powerbi/**/cache.abf
powerbi/**/*.tmp
powerbi/**/~$*
# Exported PBIX/screenshots are local portfolio artifacts, not committed
# binaries -- see docs/powerbi/portfolio_story.md for the distribution
# strategy (GitHub Release, not repository file).
powerbi/*.pbix
docs/powerbi/screenshots/*.png
